Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 40
      Cell Size: 1
      Reference Frame: map
    - Class: rviz_default_plugins/Path
      Name: Route
      Enabled: true
      Topic:
        Value: /viz/route
      Color: 200; 200; 200
    - Class: rviz_default_plugins/Marker
      Name: Vehicle
      Enabled: true
      Topic:
        Value: /viz/vehicle
    - Class: rviz_default_plugins/Marker
      Name: Trail
      Enabled: true
      Topic:
        Value: /viz/trail
    - Class: rviz_default_plugins/MarkerArray
      Name: Intersections
      Enabled: true
      Topic:
        Value: /viz/intersections
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 60
      Pitch: 1.4
      Yaw: 0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 800
  Width: 1200
